{
    "compilerOptions": {
        "target": "ES2020",
        "module": "commonjs",
        "moduleResolution": "node",
        "rootDir": "src",
        "outDir": "dist",
        "lib": [
            "ES2020"
        ],
        "strict": true,
        "noImplicitReturns": true,
        "skipLibCheck": true
    },
    "include": [
        "src/**/*.ts",
        "../../../types/**/*.d.ts"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "web"
    ]
}