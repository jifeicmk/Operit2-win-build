diff --git a/linux/emu_asbestos.c b/linux/emu_asbestos.c
--- a/linux/emu_asbestos.c
+++ b/linux/emu_asbestos.c
@@ -20,8 +20,17 @@
 	struct emu_mm *emu_mm;
 };
 
-static __thread struct tlb the_tlb;
+/* Linux tasks can migrate between host pthreads through ksetjmp/klongjmp.
+ * Darwin may cache a __thread address across that switch (see asm/current.h).
+ * Resolve the current emulated CPU each time instead of retaining a TLS address.
+ */
+static struct tlb cpu_tlbs[NR_CPUS];
 
+static struct tlb *current_tlb(void)
+{
+	return &cpu_tlbs[get_smp_processor_id()];
+}
+
 static void *ishemu_translate(struct mmu *mem, addr_t addr, int type)
 {
 	struct emu_mm *emu_mm = container_of(mem, struct emu_mm_ctx, mmu)->emu_mm;
@@ -59,7 +68,7 @@
 	expand_flags(cpu);
 	cpu->poked_ptr = &poke[get_smp_processor_id()];
 
-	int interrupt = cpu_run_to_interrupt(cpu, &the_tlb);
+	int interrupt = cpu_run_to_interrupt(cpu, current_tlb());
 
 	collapse_flags(cpu);
 	regs->ax = cpu->eax;
@@ -118,9 +127,10 @@
 
 void emu_flush_tlb_local(struct emu_mm *mm, unsigned long start, unsigned long end)
 {
-	if (the_tlb.mmu == NULL)
+	struct tlb *tlb = current_tlb();
+	if (tlb->mmu == NULL)
 		return;
-	tlb_flush(&the_tlb);
+	tlb_flush(tlb);
 	struct emu_mm_ctx *mm_ctx = mm->ctx;
 	if (mm_ctx->mmu.asbestos != NULL)
 		asbestos_invalidate_range(mm_ctx->mmu.asbestos, start / PAGE_SIZE, (end + PAGE_SIZE - 1) / PAGE_SIZE /* TODO DIV_ROUND_UP? */);
@@ -144,5 +154,5 @@
 void emu_switch_mm(struct emu *emu, struct emu_mm *mm)
 {
 	struct emu_mm_ctx *mm_ctx = mm->ctx;
-	tlb_refresh(&the_tlb, &mm_ctx->mmu);
+	tlb_refresh(current_tlb(), &mm_ctx->mmu);
 }
